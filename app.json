{
  "expo": {
    "name": "LTM Manage Company",
    "slug": "ltm-manage-company",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ltm-manage",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ltm.managecompany"
    },
    "android": {
      "package": "com.ltm.managecompany",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabase": {
        "url": "",
        "anonKey": ""
      }
    }
  }
}
