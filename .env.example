# Supabase client-side credentials (publishable/anon key ONLY — never the service-role key).
# These are used as fallback values; credentials can also be set at runtime in the
# app's Settings screen (stored on the device) or via app.json "extra.supabase".
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
